# Copy to .env in this folder (deploy/headoffice/.env). Never commit .env.

# The address staff type in, e.g. pdfdock.fc.gov.gh. A matching TLS
# certificate goes in ./certs/fullchain.pem and ./certs/privkey.pem.
PUBLIC_HOSTNAME=pdfdock.fc.gov.gh

# Long random secrets. Generate each with: openssl rand -hex 32
AUTH_SECRET=
PDF2WORD_API_KEY=

# Staff email domain. Only firstname.lastname@<this> can sign in.
STAFF_EMAIL_DOMAIN=fc.gov.gh

# Optional: only let listed addresses sign in (one per line). Put the file in
# ./staff/ and set: STAFF_ALLOWLIST_FILE=/app/staff/staff.txt
STAFF_ALLOWLIST_FILE=

# Email for sign-in codes. Use FC's mail system:
#   Microsoft 365:    SMTP_HOST=smtp.office365.com  SMTP_PORT=587  SMTP_SECURE=false
#   Google Workspace: SMTP_HOST=smtp-relay.gmail.com SMTP_PORT=587 SMTP_SECURE=false
#   FC mail server:   ask MIS for the relay host and port
MAIL_MODE=smtp
MAIL_FROM="PDFDock <no-reply@fc.gov.gh>"
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# PDF to Word worker processes. 2 suits a 4-core server; raise with more cores.
PDF2WORD_WORKERS=2
