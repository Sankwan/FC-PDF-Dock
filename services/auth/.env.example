# Staff sign-in service. Copy to .env. Never commit the real .env.

# Required in production: long random secret used to hash codes and session
# tokens. Generate with: openssl rand -hex 32
# Changing it signs everyone out.
AUTH_SECRET=

# The address staff open in their browser (no trailing slash). Used for the
# link in the email and to reject requests from other websites.
PUBLIC_URL=https://pdfdock.fc.gov.gh

# Only addresses on this domain can have an account.
STAFF_EMAIL_DOMAIN=fc.gov.gh

# Optional: a file listing the addresses allowed to sign in (one per line).
# Leave empty to accept any correctly formatted @fc.gov.gh address.
STAFF_ALLOWLIST_FILE=

# Email delivery. MAIL_MODE=smtp for real email, MAIL_MODE=console to print
# codes to the log during local development.
MAIL_MODE=smtp
MAIL_FROM="PDFDock <no-reply@fc.gov.gh>"
# Microsoft 365: smtp.office365.com, port 587, SMTP_SECURE=false (STARTTLS),
# with a licensed or shared mailbox that has SMTP AUTH enabled.
# Google Workspace: smtp-relay.gmail.com (relay) or smtp.gmail.com, port 587.
# Or FC's own mail server / relay if MIS runs one.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Tuning (defaults shown)
CODE_TTL_MINUTES=10
CODE_MAX_ATTEMPTS=5
CODE_RESEND_SECONDS=60
CODES_PER_EMAIL_PER_HOUR=5
REQUESTS_PER_IP_PER_HOUR=60
SESSION_DAYS=30

# Local development only (plain http://):
# COOKIE_SECURE=false
# MAIL_MODE=console
# PUBLIC_URL=http://localhost:5173
# Demo login (only works with MAIL_MODE=console, never in production):
# DEMO_EMAIL=demo.user@fc.gov.gh
# DEMO_CODE=123456
