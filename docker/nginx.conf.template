# Templated by the nginx:alpine entrypoint (envsubst) at container start —
# ${PORT} becomes Railway's dynamically-assigned port (falls back to the
# Dockerfile's default ENV PORT=8080 for local `docker run`). Nginx's own
# variables (like $uri below) are untouched by this since envsubst only
# substitutes names that exist as real environment variables.
server {
    listen ${PORT};
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    gzip on;
    gzip_types text/plain text/css application/javascript application/json application/wasm image/svg+xml;
    gzip_min_length 1024;

    # Same security headers as the head-office setup (CSP, HSTS, etc.).
    include /etc/nginx/security-headers.conf;

    # Keep auth same-origin for the browser while the auth service stays
    # private. Set AUTH_SERVICE_URL to the auth service's private Railway URL.
    location /api/auth/ {
        client_max_body_size 16k;
        proxy_pass ${AUTH_SERVICE_URL};
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # The service worker and PWA manifest must always be revalidated —
    # caching them lets a stale worker keep serving an old build forever.
    location = /sw.js {
        include /etc/nginx/security-headers.conf;
        add_header Cache-Control "no-cache";
    }
    location = /manifest.webmanifest {
        include /etc/nginx/security-headers.conf;
        add_header Cache-Control "no-cache";
    }

    # Vite's hashed build assets are safe to cache aggressively — a
    # content change always produces a new filename.
    location /assets/ {
        include /etc/nginx/security-headers.conf;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    # nginx's bundled mime.types has no entry for .mjs (ES modules), so it
    # falls back to application/octet-stream — browsers refuse to execute
    # a <script type="module"> or Worker with that MIME type. This is what
    # breaks pdf.worker.min.mjs (pdfjs-dist) at runtime. Regex locations
    # take priority over the /assets/ prefix location above, so the cache
    # header is repeated here.
    location ~* \.mjs$ {
        default_type application/javascript;
        include /etc/nginx/security-headers.conf;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    # SPA fallback for wouter's client-side routing — any path that isn't
    # a real file falls back to index.html instead of a 404.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
