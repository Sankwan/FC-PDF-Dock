# Copy to .env and fill in before running `docker compose up`.
# .env is gitignored — never commit real secrets.

# Required. A long random shared secret the frontend must send as the
# X-API-Key header. Generate one with: openssl rand -hex 32
API_KEY=

# Comma-separated browser origins allowed to call this API directly from
# JS (CORS). Leave empty while testing with curl/Postman — a browser tab
# won't be able to call the API at all until this is set, which is the
# safe default. Add your deployed Local PDF Toolkit origin once you wire
# up the frontend, e.g.:
# ALLOWED_ORIGINS=https://pdftoolkit.acme.internal
ALLOWED_ORIGINS=

# Reject uploads bigger than this (megabytes).
MAX_UPLOAD_MB=50

# Number of uvicorn worker *processes* — true multi-core parallelism (each
# is a separate Python process, so one worker's conversion can't block
# another's). Separate from the run_in_threadpool fix in app/main.py, which
# only keeps a single worker's event loop free to answer other requests
# (like /health) while it's busy with one conversion. 2 is a reasonable
# default for a modest CPU allocation (e.g. Railway's Hobby tier); raise it
# if you give the container more vCPUs and see conversions queuing up under
# concurrent load.
WEB_CONCURRENCY=2

# Max parallel Tesseract processes OCRmyPDF spawns *per conversion* (its
# own page-level parallelism, separate from WEB_CONCURRENCY above). Without
# this, OCRmyPDF defaults to one process per visible CPU, which can
# over-subscribe a shared/limited container under concurrent uploads.
OCR_JOBS=2

# Do NOT set PORT here for local/docker-compose use — leave it unset so the
# Dockerfile's default (8000) applies, matching docker-compose.yml's port
# mapping. PORT is a Railway-specific mechanism (Railway injects it at
# runtime and expects the app to bind to it) — see DEPLOYMENT.md.
