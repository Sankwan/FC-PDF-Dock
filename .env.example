# Copy this to .env (default build) or .env.<company> and build with
# `vite build --mode <company>` to produce a separate branded bundle
# for a sister company — see README.md "Branding for sister companies".

VITE_APP_NAME="PDFDock"
VITE_APP_SHORT_NAME="PDFDock"
VITE_APP_DESCRIPTION="Merge, split, compress, and convert PDFs entirely in your browser. Nothing you open here is ever uploaded."
# Keep this in sync with --brand in client/src/index.css — it's only used
# for the PWA manifest/status-bar color, not the in-app styling.
VITE_THEME_COLOR="#0d6e5c"

# Optional — only needed to enable the "PDF to Word" tool, the one tool
# that isn't purely client-side (see services/pdf-to-word/README.md and
# README.md's "PDF to Word" section). Leave both blank to hide that tool
# behind a clean "not set up" message instead of a broken one.
#
# WARNING: both values are inlined into the public JS bundle at build
# time — anyone can read them from dev tools. The API key is NOT a real
# secret once deployed this way; it only filters casual/automated hits.
# Real access control belongs at the network layer (Cloudflare Access,
# or a Tailscale-only address) — see services/pdf-to-word/SECURITY.md.
VITE_PDF2WORD_API_URL=
VITE_PDF2WORD_API_KEY=
