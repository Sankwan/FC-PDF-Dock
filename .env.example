# Copy this to .env before `npm run build`. Every VITE_ value is inlined
# into the public JS bundle at build time, so never put secrets here.

VITE_APP_NAME="PDFDock"
VITE_APP_SHORT_NAME="FC PDFDock"
VITE_ORG_NAME="Forestry Commission"
VITE_APP_DESCRIPTION="Document tools for Forestry Commission staff. Convert, scan and prepare documents on your device."
# Header/status-bar colour. Keep in sync with --chrome in client/src/index.css.
VITE_THEME_COLOR="#0E2516"

# Staff sign-in (services/auth). When "true", every page asks staff to sign
# in with their @fc.gov.gh address first. The auth API is reached on the same
# origin at /api/auth (nginx proxies it; see deploy/headoffice/).
VITE_AUTH_REQUIRED="true"
# Public, serverless pilot login only. Credentials are displayed on the page.
# Keep false for internal staff deployments; this does not create an API session.
VITE_DEMO_MODE="false"
# Only addresses on this domain can create an account (the server enforces
# this too; this copy is only for form validation and wording).
VITE_STAFF_EMAIL_DOMAIN="fc.gov.gh"

# PDF to Word now runs in the browser. No conversion URL, key or
# VITE_PDF2WORD_ENABLED flag is required. Older deployments may keep their
# optional conversion service; this frontend does not call it.
